{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secguardian.dev/protocols/findings-schema.json",
  "title": "SecGuardian Findings Protocol v1.0",
  "description": "AI-to-Renderer contract — v7.0 added RelatedFinding for finding relationship modeling. See scan-output.md for directory structure.",
  "type": "object",
  "required": [
    "schema_version",
    "scan_id",
    "command",
    "started_at",
    "completed_at",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Protocol version — renderer rejects unknown versions"
    },
    "scan_id": {
      "type": "string",
      "pattern": "^s[ce][ca]-\\d{8}-\\d{6}-[a-z0-9]{4}$",
      "description": "sc- = secguard scan, sec- = secaudit audit"
    },
    "command": {
      "type": "string",
      "enum": [
        "secguard",
        "secaudit",
        "secreview"
      ],
      "description": "Which slash command produced these findings"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 scan start timestamp"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 scan completion timestamp"
    },
    "duration_ms": {
      "type": "integer",
      "description": "Wall-clock duration in milliseconds (completed_at - started_at)"
    },
    "path": {
      "type": "string",
      "description": "Scanned source path, e.g. './src'"
    },
    "mode": {
      "type": "string",
      "description": "Scan mode: 'full' or 'git diff <ref>'"
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Detector filters applied, e.g. ['memory.*', 'system.*']"
    },
    "language": {
      "type": "string",
      "description": "Primary detected language: go, python, java, cpp, javascript"
    },
    "scope": {
      "type": "object",
      "description": "Scan scope statistics from index.json",
      "properties": {
        "files": {
          "type": "integer"
        },
        "lines": {
          "type": "integer"
        },
        "functions": {
          "type": "integer"
        },
        "call_edges": {
          "type": "integer"
        }
      }
    },
    "detectors": {
      "type": "object",
      "description": "Detector execution statistics",
      "properties": {
        "matched": {
          "type": "integer"
        },
        "executed": {
          "type": "integer"
        },
        "namespaces_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "security_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Calculated by renderer, but can be pre-set by AI"
    },
    "findings": {
      "type": "array",
      "description": "All security findings from this scan",
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "good_patterns": {
      "type": "array",
      "description": "Positive patterns found in code (correct implementations to highlight)",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "secaudit_specific": {
      "type": "object",
      "description": "Secaudit-only metadata. Null for secguard/secreview.",
      "properties": {
        "skill_name": {
          "type": "string",
          "description": "The secaudit skill invoked, e.g. 'taint-analysis'"
        },
        "skill_category": {
          "type": "string",
          "enum": [
            "analysis",
            "domain"
          ],
          "description": "Whether this is an analysis method or domain audit"
        },
        "analysis_paths": {
          "type": "integer",
          "description": "Number of Source→Propagation→Sink paths analyzed"
        },
        "complete_chains": {
          "type": "integer",
          "description": "Number of fully traced chains"
        }
      }
    },
    "secreview_specific": {
      "type": "object",
      "description": "Secreview-only metadata. Null for secguard/secaudit.",
      "properties": {
        "review_type": {
          "type": "string",
          "enum": [
            "full",
            "incremental",
            "targeted"
          ],
          "description": "Review scope"
        },
        "review_focus": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Review focus areas, e.g. ['security', 'performance', 'code-quality']"
        }
      }
    }
  },
  "$defs": {
    "SingleFindingFile": {
      "type": "object",
      "description": "v5.0 single-finding file format — one file per finding in findings/<namespace>/<detector>/",
      "required": [
        "schema_version",
        "finding"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "finding": {
          "$ref": "#/$defs/Finding"
        }
      }
    },
    "FindingsIndex": {
      "type": "object",
      "description": "v5.0 findings.json — same filename as v4.0, now lightweight index (metadata + finding references only, no 4-segment bodies)",
      "required": [
        "scan_id",
        "findings_index"
      ],
      "properties": {
        "scan_id": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "timing": {
          "type": "object",
          "properties": {
            "started": {
              "type": "string",
              "format": "date-time"
            },
            "completed": {
              "type": "string",
              "format": "date-time"
            },
            "duration_ms": {
              "type": "integer"
            }
          }
        },
        "scope": {
          "$ref": "#/properties/scope"
        },
        "detectors": {
          "$ref": "#/properties/detectors"
        },
        "security_score": {
          "$ref": "#/properties/security_score"
        },
        "findings_index": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "severity",
              "detector",
              "file",
              "line",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              },
              "cwe": {
                "type": "string"
              },
              "detector": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer"
              },
              "function": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "description": "Relative path to single finding file, e.g. findings/web/sql-injection/H-SQLI-webapp-L47.json"
              }
            }
          }
        }
      }
    },
    "Finding": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "cwe",
        "detector",
        "file",
        "line",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[CLHMLI]-[A-Z0-9]+-[a-z_]+-L\\d+$",
          "description": "Finding ID: <SEVERITY>-<DETECTOR_ABBREV>-<FILE_SLUG>-L<LINE>"
        },
        "severity": {
          "type": "string",
          "enum": [
            "Critical",
            "High",
            "Medium",
            "Low",
            "Info"
          ],
          "description": "CVSS-aligned severity level"
        },
        "cwe": {
          "type": "string",
          "pattern": "^CWE-\\d+$",
          "description": "CWE identifier, e.g. CWE-89"
        },
        "detector": {
          "type": "string",
          "description": "Detector namespace.name, e.g. 'web.sql-injection'"
        },
        "file": {
          "type": "string",
          "description": "Relative file path from scan root, e.g. 'src/webapp.go'"
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "Primary line number of the vulnerability"
        },
        "function": {
          "type": "string",
          "description": "Function/method name containing the finding"
        },
        "title": {
          "type": "string",
          "description": "One-line finding title for table display"
        },
        "fix_summary": {
          "type": "string",
          "description": "One-line fix suggestion for table display"
        },
        "location": {
          "type": "object",
          "description": "📍 Location — 4-segment protocol",
          "required": [
            "file_path",
            "start_line",
            "function_name",
            "snippet"
          ],
          "properties": {
            "file_path": {
              "type": "string"
            },
            "start_line": {
              "type": "integer"
            },
            "end_line": {
              "type": "integer"
            },
            "function_name": {
              "type": "string"
            },
            "snippet": {
              "type": "string",
              "description": "3+ lines of code context with line numbers"
            }
          }
        },
        "evidence": {
          "type": "object",
          "description": "📋 Evidence — 4-segment protocol",
          "required": [
            "code_context",
            "judgment_rationale"
          ],
          "properties": {
            "code_context": {
              "type": "string",
              "description": "Expanded code context showing the vulnerability"
            },
            "judgment_rationale": {
              "type": "string",
              "description": "Why this is a vulnerability — the reasoning"
            },
            "data_flow_path": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "step": {
                    "type": "string",
                    "enum": [
                      "source",
                      "propagation",
                      "sink"
                    ]
                  },
                  "file": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              },
              "description": "Source → Propagation → Sink data flow trace (secguard/secaudit)"
            },
            "call_stack": {
              "type": "array",
              "description": "📋 Evidence: Call chain from entry function to vulnerability location — for cross-function tracing",
              "items": {
                "type": "object",
                "required": [
                  "function",
                  "file",
                  "line"
                ],
                "properties": {
                  "function": {
                    "type": "string",
                    "description": "Function name"
                  },
                  "file": {
                    "type": "string",
                    "description": "File path"
                  },
                  "line": {
                    "type": "integer",
                    "description": "Line number in this function"
                  },
                  "depth": {
                    "type": "integer",
                    "description": "Call depth (0 = entry point)"
                  }
                }
              }
            },
            "variable_state": {
              "type": "object",
              "description": "📋 Evidence: Variable/value snapshot at vulnerability trigger point — for exploitability assessment",
              "properties": {
                "variable_name": {
                  "type": "string",
                  "description": "Variable name"
                },
                "inferred_value": {
                  "type": "string",
                  "description": "Inferred/possible value at trigger point"
                },
                "type": {
                  "type": "string",
                  "description": "Variable type"
                },
                "constraints": {
                  "type": "string",
                  "description": "Known constraints on the value"
                }
              }
            },
            "sanitizer_analysis": {
              "type": "object",
              "description": "📋 Evidence: Sanitizer presence and adequacy analysis — for FP elimination gate",
              "required": [
                "sanitizer_present",
                "verdict"
              ],
              "properties": {
                "sanitizer_present": {
                  "type": "boolean",
                  "description": "Whether any sanitizer/validator exists on the data path"
                },
                "sanitizer_name": {
                  "type": "string",
                  "description": "Name of sanitizer function if present"
                },
                "bypass_reason": {
                  "type": "string",
                  "description": "Why the sanitizer is insufficient or can be bypassed"
                },
                "verdict": {
                  "type": "string",
                  "enum": [
                    "no_sanitizer",
                    "sanitizer_bypassed",
                    "sanitizer_insufficient",
                    "sanitizer_adequate"
                  ],
                  "description": "Final verdict on sanitizer adequacy"
                }
              }
            }
          }
        },
        "impact": {
          "type": "object",
          "description": "⚠️ Impact — 4-segment protocol",
          "required": [
            "attack_scenario",
            "cvss_score"
          ],
          "properties": {
            "attack_scenario": {
              "type": "string",
              "description": "Concrete attack scenario description"
            },
            "cvss_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "description": "CVSS 3.1 base score"
            },
            "cvss_vector": {
              "type": "string",
              "pattern": "^CVSS:3\\.1/AV:[NALP]/AC:[LH]/PR:[NLH]/UI:[NR]/S:[UC]/C:[NLH]/I:[NLH]/A:[NLH]",
              "description": "CVSS 3.1 vector string"
            },
            "exploit_conditions": {
              "type": "string",
              "description": "Conditions required for exploitation"
            }
          }
        },
        "fix": {
          "type": "object",
          "description": "🔧 Fix — 4-segment protocol",
          "required": [
            "description",
            "before_code",
            "after_code"
          ],
          "properties": {
            "description": {
              "type": "string",
              "description": "Human-readable fix description"
            },
            "before_code": {
              "type": "string",
              "description": "Vulnerable code (before)"
            },
            "after_code": {
              "type": "string",
              "description": "Fixed code (after)"
            },
            "effort_hours": {
              "type": "number",
              "description": "Estimated fix effort in hours"
            },
            "verification_method": {
              "type": "string",
              "description": "How to verify the fix works"
            }
          }
        },
        "sarif_specific": {
          "type": "object",
          "description": "SARIF-only metadata not rendered in report.md",
          "properties": {
            "confidence": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "description": "Detection confidence"
            },
            "risk_of_fix": {
              "type": "string",
              "enum": [
                "none",
                "low",
                "medium",
                "high"
              ],
              "description": "Risk of introducing regression with the fix"
            },
            "detector_namespace": {
              "type": "string",
              "description": "Detector namespace for SARIF ruleIndex mapping"
            }
          }
        },
        "relationships": {
          "type": "array",
          "description": "v7.0: Related findings that share context. AI Agent marks high-value relationships; Renderer auto-detects same-function/file relationships",
          "items": {
            "$ref": "#/$defs/RelatedFinding"
          }
        }
      }
    },
    "RelatedFinding": {
      "type": "object",
      "description": "v7.0: Related finding reference — indicates a finding that shares context (same function, file, or data flow) and should be fixed together",
      "required": [
        "finding_id",
        "relationship_type"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "description": "Finding ID of the related finding"
        },
        "relationship_type": {
          "type": "string",
          "enum": [
            "same_function",
            "same_file",
            "data_flow",
            "consequence",
            "ai_suggested"
          ],
          "description": "How this finding relates to the current one"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the relationship"
        }
      }
    }
  }
}