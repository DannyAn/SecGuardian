# SecGuardian .gitignore

# AI CLI deployment targets (generated at deploy time, not source)
.claude/
.claude-plugin/
.opencode/
.gemini/

# Build output
dist/

# Scan output (runtime artifacts)
.codeagent/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.bak

# macOS resource forks
._*

# Build artifacts (Go binaries)
internal/secguardian
internal/secguardian-cli
internal/secguardian-index
scripts/secguardian
scripts/bin/

# CI/CD local config
tools/.claude/

# Session state (superpowers)
.superpowers/

# IDE artifacts (clawdbot editor mode)
.arts/

# Session transcripts (generated by AI agents)
session-*.md

# 构建时生成的 Gemini .toml 文件
commands/gemini/*.toml
# Python bytecode cache
__pycache__/
secguardian-*
