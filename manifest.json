    "ci_cd": {
      "github_actions": "action.yml (upload-sarif → GitHub Code Scanning)",
      "gitlab_ci": "artifacts:reports:sast → GitLab SAST Dashboard",
      "azure_devops": "SARIF SAST Scans tab"
    }
  },
  "changelog": {
    "0.5.1": {
      "date": "2026-05-31",
      "changes": [
        "★ 输出协议升级 v2.0: 人读/机读分离 — findings/*.json 废弃，改为 report.md + results.sarif + summary.json",
        "report.md: Markdown 格式安全审计报告，含执行摘要/检出清单/详细发现/修复优先级",
        "results.sarif: 始终生成（不再需要 --sarif flag），CI/CD 原生输入",
        "summary.json: 轻量仪表盘统计 — 按严重度/命名空间/语言分组",
        "manifest.json: 精简为元数据+检出索引，不再内联完整 finding",
        "SARIF 生成规则: partialFingerprints 去重 + GitHub/GitLab/Azure 兼容"
      ]
    },
    "0.5.0": {
      "date": "2026-05-31",
      "changes": [
        "★ 架构重构: concept+detector 双文件合并为自包含 detector (WHAT+HOW+FIX 一体化)",
        "删除 knowledge/concepts/ 目录 (17 个零散文件)，替换为 knowledge/threat-catalog.md 单文件索引",
        "每个 detector 现在自包含: 威胁定义 → 检测逻辑 → 修复指引 → 误报排除 → 模式汇总",
        "新增 error 命名空间 (6 个检测器): stack-trace-leak, log-sensitive-data, exception-swallow, unified-error-format, debug-mode-production, panic-to-client",
        "crypto 命名空间扩展 (4→9): 新增 aes-ecb-mode, tls-version, custom-crypto, password-storage, hardcoded-iv",
        "system.command-injection + path-traversal 全语言扩展 (c,cpp → 全6语)",
        "crypto.* 全语言扩展 (c,cpp → 全6语)",
        "web 命名空间扩展 (17→22): 新增 mass-assignment, excessive-data-exposure, nosql-injection, prototype-pollution, ssti",
        "新增 JavaScript/Node.js 语言支持: knowledge/languages/javascript.md + secguard-js + secreview-js",
        "新增 4 个 knowledge/standards: SEI CERT C/C++/Java 映射 + OWASP Cheat Sheet 映射",
        "secreview 反模式检测矩阵深化: 5 个语言全面升级为具体 detection patterns",
        "CWE Top 25 覆盖率: 88% → 100%",
        "OWASP API Top 10 覆盖率: 部分 → 100%",
        "检测器总数: 45 → 60 (+33%)",
        "多语言 detector 占比: 38% → 69% (+81%)"
      ]
    }
