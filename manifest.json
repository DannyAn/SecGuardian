    "machine_readable": "results.sarif (SARIF 2.1.0, 始终生成, CI/CD 标准)",
    "dashboard": "summary.json (轻量统计)",
    "structure": {
      "secguard-secguardian": "scans/<scan-id>/report.md + results.sarif + summary.json + manifest.json",
      "secaudit-secguardian": "scans/<scan-id>/report.md + results.sarif + summary.json + manifest.json",
      "secreview-secguardian": "scans/<scan-id>/report.md + results.sarif + summary.json + manifest.json"
    }
  },
