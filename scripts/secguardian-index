#!/bin/bash
# SecGuardian — Indexer binary wrapper (shared index)
#
# All commands (secguard/secaudit/secreview) share one index.json at
# the project root (.codeagent/index.json). If the file already exists,
# the build is skipped. Use --force to force rebuild.
#


SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BIN_DIR="$SCRIPT_DIR/bin"

# --- Parse --path / --output for caching ---
SRC_PATH=""
OUTPUT_PATH=""
FORCE_REBUILD=0
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --path) SRC_PATH="$2"; ARGS+=("$1" "$2"); shift 2 ;;
        --output) OUTPUT_PATH="$2"; ARGS+=("$1" "$2"); shift 2 ;;
        --force) FORCE_REBUILD=1; shift ;;
        *) ARGS+=("$1"); shift ;;
    esac
done
# Resolve --path to absolute BEFORE running (match Go indexer's stored path)
if [ -n "$SRC_PATH" ]; then
    ABS_PATH="$(python3 -c "import os; print(os.path.abspath('$SRC_PATH'))" 2>/dev/null)"
    if [ -n "$ABS_PATH" ]; then
        SRC_PATH="$ABS_PATH"

    fi
fi
set -- "${ARGS[@]}"

# --- Shared index: if --output path already exists, skip build ---
# This makes index.json a shared asset — once built, all commands reuse it.
# Use --force to force rebuild even if the file exists.
# If the file exists, verify the stored --path matches the current one.
if [ "$FORCE_REBUILD" -ne 1 ] && [ -n "$OUTPUT_PATH" ] && [ -f "$OUTPUT_PATH" ] && [ -n "$SRC_PATH" ]; then
    STORED_PATH=$(python3 -c "
import json
try:
    d = json.load(open('$OUTPUT_PATH'))
    print(d.get('path', ''))
except: print('')
" 2>/dev/null)
    RESOLVED_PATH="$SRC_PATH"  # Use raw path (Go indexer stores it as-is)
    if [ "$STORED_PATH" = "$RESOLVED_PATH" ]; then
        echo "INDEX EXISTS: $OUTPUT_PATH (path matches, use --force to rebuild)" >&2
        exit 0
    elif [ -n "$STORED_PATH" ]; then
        echo "INDEX PATH MISMATCH: stored=$STORED_PATH vs current=$RESOLVED_PATH — rebuilding" >&2
    fi
fi

# --- Locate binary ---
locate_binary() {
    local c="$BIN_DIR/secguardian-index"
    if [ -f "$c" ] && [ -x "$c" ]; then echo "$c"; return 0; fi
    local os arch
    os="$(uname -s | tr '[:upper:]' '[:lower:]')"
    arch="$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')"
    local p="$BIN_DIR/secguardian-index-${os}-${arch}"
    if [ -f "$p" ] && [ -x "$p" ]; then echo "$p"; return 0; fi
    local d="$SCRIPT_DIR/../internal/secguardian-index"
    if [ -f "$d" ] && [ -x "$d" ]; then echo "$d"; return 0; fi
    return 1
}
BINARY="$(locate_binary)" || {
    echo "Indexer binary not found. Expected: $BIN_DIR/secguardian-index or platform variant" >&2
    exit 1
}

# --- Run binary ---
"$BINARY" "$@"
BINARY_EXIT=$?

exit $BINARY_EXIT
