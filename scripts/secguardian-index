#!/bin/bash
# SecGuardian — Cross-platform indexer binary wrapper
#
# Detects host OS and CPU architecture and executes the appropriate binary.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BIN_DIR="$SCRIPT_DIR/bin"

OS="$(uname -s)"
ARCH="$(uname -m)"

# Normalize OS
case "$OS" in
    Darwin)
        OS_NAME="darwin"
        ;;
    Linux)
        OS_NAME="linux"
        ;;
    *)
        echo "Unsupported OS: $OS" >&2
        exit 1
        ;;
esac

# Normalize ARCH
case "$ARCH" in
    x86_64|amd64)
        ARCH_NAME="amd64"
        ;;
    arm64|aarch64)
        ARCH_NAME="arm64"
        ;;
    *)
        echo "Unsupported architecture: $ARCH" >&2
        exit 1
        ;;
esac

# Determine the binary name
TARGET_BIN="$BIN_DIR/secguardian-index-${OS_NAME}-${ARCH_NAME}"

# Check target binary
if [ ! -f "$TARGET_BIN" ]; then
    # Try parent internal directory if in source repo
    DEV_BIN="$SCRIPT_DIR/../internal/secguardian-index"
    if [ -f "$DEV_BIN" ] && [ -x "$DEV_BIN" ]; then
        exec "$DEV_BIN" "$@"
    fi

    echo "Indexer binary not found for platform: ${OS_NAME}-${ARCH_NAME} (expected: $TARGET_BIN)" >&2
    exit 1
fi

# Execute the binary
exec "$TARGET_BIN" "$@"
