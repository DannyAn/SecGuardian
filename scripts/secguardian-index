#!/bin/bash
# SecGuardian — Indexer binary wrapper
#
# Invokes the canonical secguardian-index binary from bin/.
# In release packages the binary is always named 'secguardian-index'
# regardless of platform (darwin-arm64, linux-amd64, etc.).

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BIN_DIR="$SCRIPT_DIR/bin"
CANONICAL="$BIN_DIR/secguardian-index"

# 1. Canonical name (release packages, platform-specific deploy)
if [ -f "$CANONICAL" ] && [ -x "$CANONICAL" ]; then
    exec "$CANONICAL" "$@"
fi

# 2. Platform-specific fallback (multi-platform dev builds)
OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')"
PLATFORM_BIN="$BIN_DIR/secguardian-index-${OS}-${ARCH}"
if [ -f "$PLATFORM_BIN" ] && [ -x "$PLATFORM_BIN" ]; then
    exec "$PLATFORM_BIN" "$@"
fi

# 3. Dev fallback: source repo internal/ build
DEV_BIN="$SCRIPT_DIR/../internal/secguardian-index"
if [ -f "$DEV_BIN" ] && [ -x "$DEV_BIN" ]; then
    exec "$DEV_BIN" "$@"
fi

echo "Indexer binary not found. Expected: $CANONICAL or $PLATFORM_BIN" >&2
exit 1
